<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>../../NicoBE/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
    <Reference Include="NicoBE"><HintPath>$(NicoBEAssembly)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireBinary" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(NicoBEAssembly)')" Text="Specify NicoBEAssembly from an extracted release ZIP."/></Target>
</Project>
